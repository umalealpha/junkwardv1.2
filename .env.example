# ============================================================================
# Alpha Direct Finance — Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` (NEVER commit `.env`) and fill in real values.
#
# Generate a strong SECRET_KEY:
#   python -c "from secrets import token_urlsafe; print(token_urlsafe(50))"
#
# Generate a strong DB_PASSWORD:
#   python -c "from secrets import token_urlsafe; print(token_urlsafe(32))"
# ============================================================================

# ---- Django core ----
SECRET_KEY="change-me-to-a-50-char-random-string"
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database (Postgres) ----
DB_NAME=alpha_finance
DB_USER=alpha_admin
DB_PASSWORD="change-me-to-a-strong-random-password"
DB_HOST=db
DB_PORT=5432

# ---- Bootstrapping (first-boot only — flip to 0 once seeded) ----
# 1 = run setup_initial_data + setup_chart_of_accounts on container start
DJANGO_SEED_INITIAL=1
# 1 = create the Django superuser if it doesn't already exist
DJANGO_CREATE_SUPERUSER=1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@alphadirect.local
DJANGO_SUPERUSER_PASSWORD="change-me-strong-admin-password"

# ---- Application ----
DEFAULT_CURRENCY=BWP
SUPPORTED_CURRENCIES=BWP,USD,ZAR,INR,ZMW

# ---- Optional: Anthropic AI document processing ----
ANTHROPIC_API_KEY=

# ---- Optional: DeepSeek reasoning (non-sensitive tasks only) ----
# Approved by CFO 2026-05-09 as an explicit exception to AD-POL-AI-GOV-001.
# Used for chart-of-accounts suggestions and similar reasoning tasks where
# no PII / financial figures leave the system. See core/ai_assist.py.
# Use a freshly-rotated key — never the one shared in chat.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Email — approver notifications ----
# Default backend is console (logs to stdout). For production set:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=alpha-finance@alphadirect.co.bw
APP_BASE_URL=http://localhost:3001
NOTIFICATIONS_ENABLED=True

# ---- Telegram CFO Bot — read-only ERP query interface ----
# Long-running bot, run with:  python manage.py run_telegram_bot
# Token from BotFather (https://t.me/BotFather). Treat as a secret.
TELEGRAM_BOT_TOKEN=
# Initial password gate. Change after first deploy.
TELEGRAM_BOT_PASSWORD=admin123
# Comma-separated Telegram user IDs allowed to use the bot. Empty = open
# (still password-gated). Get your ID by messaging @userinfobot on Telegram.
TELEGRAM_BOT_AUTHORIZED_USERS=
# Idle timeout (minutes) before re-auth required. Default 60.
TELEGRAM_BOT_SESSION_MINUTES=60

# ---- Azure AD SSO (P4 — dormant until IT provides app registrations) ----
# See infra/azure-sso-setup.md. While AZURE_SSO_ENABLED=False the JWT auth
# class short-circuits and the existing Token / Session auth keeps working.
AZURE_SSO_ENABLED=False
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=
AZURE_API_AUDIENCE=api://omni-api
AZURE_ADMIN_GROUP_ID=

# ---- Azure AD SSO (frontend MSAL — values baked into Next.js bundle at build) ----
# When set, the login page shows a 'Sign in with Microsoft' button.
# Same tenant as the backend; client_id is the SPA app registration
# (e.g. OneDesk Web — add 'https://omni.alphadirect.co.bw' as redirect URI).
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_API_SCOPE=

# ============================================================================
# PRODUCTION ONLY — uncomment and set these when deploying behind HTTPS (AWS ALB)
# ============================================================================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
