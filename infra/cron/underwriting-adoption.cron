# Underwriting tool adoption — the Monday-morning email to each underwriter
# (CFO Amendment 3, 2026-09-08). One email per underwriter, the Underwriting
# Manager copied: renewals last week vs quotes actually built in the Quote
# builder, and the gap between the two.
#
# Runs the Django management command inside the running backend container.
# Installed by infra/install-crons.sh (cp + chmod 644 into /etc/cron.d/).
#
# Schedule: every Monday 07:00 SAST  (SAST = UTC+02 -> 05:00 UTC).
# Early enough to be the first thing on a Monday, late enough that the figures
# cover the whole of the previous week.
#
# Test it first — this SENDS mail:
#   docker compose exec -T backend python manage.py underwriting_adoption_email --dry-run
#
# Output -> /var/log/underwriting-adoption.log.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 5 * * 1 root cd /opt/alpha-finance && /usr/bin/docker compose --env-file /etc/alpha-finance/.env exec -T backend python manage.py run_job underwriting-adoption -- underwriting_adoption_email >> /var/log/underwriting-adoption.log 2>&1
